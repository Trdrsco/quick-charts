{
  "name": "quickcharts",
  "version": "0.0.0-staging",
  "description": "Quick Charts: a datafeed-driven charting library with drawings, indicators, layouts and replay over host-supplied data and storage ports.",
  "keywords": [
    "charts",
    "charting",
    "financial-charts",
    "candlestick",
    "trading-chart",
    "datafeed",
    "drawings",
    "indicators",
    "lightweight-charts",
    "typescript"
  ],
  "homepage": "https://github.com/Trdrsco/quick-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trdrsco/quick-charts.git"
  },
  "bugs": {
    "url": "https://github.com/Trdrsco/quick-charts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": "./src/index.ts",
    "./drawings": "./src/drawings/index.ts",
    "./adapters/rest": "./src/adapters/rest/index.ts",
    "./styles.css": "./dist/quickcharts.css"
  },
  "files": [
    "dist",
    "!dist/guest",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "dist/quickcharts.css",
    "src/styles/*.css",
    "src/styles/components/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./drawings": {
        "types": "./dist/drawings.d.ts",
        "import": "./dist/drawings.js"
      },
      "./adapters/rest": {
        "types": "./dist/adapters/rest.d.ts",
        "import": "./dist/adapters/rest.js"
      },
      "./styles.css": "./dist/quickcharts.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:theme": "node scripts/build-theme.mjs",
    "build:manifest": "node scripts/build-feature-manifest.mjs",
    "build:guest": "node scripts/build-guest.mjs",
    "build:rest-openapi": "node scripts/build-rest-openapi.mjs",
    "build:notices": "node scripts/build-third-party-notices.mjs",
    "pack:candidate": "node scripts/pack-candidate.mjs",
    "postbuild": "node scripts/build-theme.mjs && node scripts/build-feature-manifest.mjs && node scripts/build-guest.mjs && node scripts/build-rest-openapi.mjs && node scripts/build-third-party-notices.mjs && node scripts/pack-candidate.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate": "node scripts/gate.mjs",
    "check:notices": "node scripts/build-third-party-notices.mjs --check",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:i18n": "node scripts/i18n.mjs check",
    "clean-room": "node clean-room/run.mjs",
    "rehearsal": "node scripts/release-rehearsal.mjs",
    "i18n": "node scripts/i18n.mjs"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "devDependencies": {
    "fancy-canvas": "2.1.0",
    "happy-dom": "^20.13.2",
    "lightweight-charts": "5.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
