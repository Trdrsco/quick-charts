{
  "name": "@trdrs/chart",
  "version": "0.2.0",
  "description": "trdrs charting library: a datafeed-driven trading chart widget with broker, storage and override seams. Commercial license required.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external lightweight-charts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trdrs/chart-drawings": "workspace:^",
    "@trdrs/i18n": "workspace:^"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "devDependencies": {
    "lightweight-charts": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
