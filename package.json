{
  "name": "quickcharts",
  "version": "0.0.0-staging",
  "description": "Quick Charts: a datafeed-driven charting library with drawings, indicators, layouts and replay over host-supplied data and storage ports.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/quickcharts.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "dist/quickcharts.css",
    "src/styles/*.css"
  ],
  "publishConfig": {
    "access": "restricted",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/quickcharts.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:theme": "node scripts/build-theme.mjs",
    "postbuild": "node scripts/build-theme.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "devDependencies": {
    "@trdrs/chart-drawings": "workspace:^",
    "@trdrs/chart-indicators": "workspace:^",
    "lightweight-charts": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
